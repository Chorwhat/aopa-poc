---
import ActivityLayout from "../../../../layouts/ActivityLayout.astro";
import SectionRenderer from "../../../../components/SectionRenderer.astro";
import { getActivitySection } from "../../../../server/dynamicmockActivityAssembler";


import activitiesData from "../../../../data/activities.json";

export async function getStaticPaths() {
  const views = [
    "overview",
    "checklist",
    "notestopilot",
    "commonerrors",
    "teachingtips",
    "alternateprocedures",
    "prep",
    "regulatory",
  ];

  const paths = [];

  for (const category of activitiesData.categories ?? []) {
    for (const activity of category.activities ?? []) {
      for (const view of views) {
        paths.push({
          params: {
            activityId: activity.id,
            view,
          },
        });
      }
    }
  }

  return paths;
}

const { activityId, view } = Astro.params;

const section = await getActivitySection(activityId, view);

if (!section) {
  throw new Response("Not found", { status: 404 });
}
---

<ActivityLayout activityId={activityId} activeView={view}>
  <SectionRenderer section={section} />
</ActivityLayout>
