---
const { section } = Astro.props;

const isChecklist = section.key === "checklist";
const isPrepOrRegulatory = section.key === "prep" || section.key=== "regulatory";
---
<section>
  <h1>{section.label}</h1>

  {/* PREP: no activity-block wrapper */}
  {isPrepOrRegulatory && section.blocks.map(block => (
    <>
      {block.table && (
        <div class="table-container">
          <table class="prep-table">
            <thead>
              <tr>
                {block.table.headers.map(h => <th>{h}</th>)}
              </tr>
            </thead>
            <tbody>
              {block.table.rows.map(row => (
                <tr>
                  {row.map(cell => <td set:html={cell} />)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </>
  ))}

  {/* CHECKLIST: one card per block */}
  {isChecklist && section.blocks.map(block => (
    <div class="activity-block">
      {block.heading && <h3>{block.heading}</h3>}
      {block.body && <p set:html={block.body} />}
      {block.list && <ul>{block.list.map(i => <li>{i}</li>)}</ul>}
    </div>
  ))}

  {/* DEFAULT: one card for entire section */}
  {!isChecklist && !isPrepOrRegulatory && (
    <div class="activity-block">
      {section.blocks.map(block => (
        <>
          {block.heading && <h3>{block.heading}</h3>}
          {block.body && <p set:html={block.body} />}

          {block.list && (
            <ul>
              {block.list.map(item => <li>{item}</li>)}
            </ul>
          )}

          {block.table && (
            <div class="table-container">
              <table class="prep-table">
                <thead>
                  <tr>
                    {block.table.headers.map(h => <th>{h}</th>)}
                  </tr>
                </thead>
                <tbody>
                  {block.table.rows.map(row => (
                    <tr>
                      {row.map(cell => <td set:html={cell} />)}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {block.linkGrid && (
            <div class="link-grid">
              {block.linkGrid.map(link => (
                <a href={link.href} class="link-item">{link.text}</a>
              ))}
            </div>
          )}
        </>
      ))}
    </div>
  )}
</section>

